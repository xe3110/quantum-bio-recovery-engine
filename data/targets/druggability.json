{
  "metadata": {
    "version": "1.0.0",
    "purpose": "Per-target modality annotation. Tells the de novo design layer which proteins a small molecule can realistically engage, so the target product profile is not built around targets only an antibody can reach.",
    "schema": {
      "target_class": "broad protein family",
      "small_molecule_tractability": "0-1 ordinal prior that a drug-like small molecule can productively engage this protein; 0 marks a transcriptional readout rather than a target",
      "note": "the reason for the value, so it can be argued with"
    },
    "curation_rule": "Ordinal priors reflecting precedent in the public literature: an approved small molecule against the target scores highest, a published chemotype without approval sits mid-range, and proteins that appear in the signature only as downstream readouts score at or near zero. These are judgements, not measurements, and every one should be re-derived before publication use.",
    "readout_convention": "A target scoring below 0.2 is treated by the design engine as a readout: the profile may require its expression to move, but no arm of a designed molecule will be assigned to bind it.",
    "n_targets": 93
  },
