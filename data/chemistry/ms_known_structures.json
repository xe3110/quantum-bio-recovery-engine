  "metadata": {
    "version": "1.0.0",
    "purpose": "Structures for the small-molecule members of ms_panel_v3, used as the known-chemical-matter reference set for novelty assessment.",
    "curation_rule": "Every entry carries the molecular formula and average mass reported in the public literature for that agent. tests/test_chemistry.py re-derives both from the SMILES and fails on any disagreement, so a mistyped structure cannot enter the reference set silently.",
    "omissions": "Biologics (monoclonal antibodies, interferons, glatiramer acetate) have no small-molecule structure and are absent by construction. A small number of complex natural products are also absent where a structure could not be transcribed with confidence; absence weakens novelty checking against those agents and nothing else.",
    "stereochemistry": "SMILES are written without stereo-descriptors because the molecule model does not carry stereochemistry. Formula and mass are unaffected; any claim requiring a defined stereocentre is out of scope.",
    "sources": [
      "DrugBank",
      "PubChem",
      "ChEMBL"
    ]
  },
